      <artifactId>ubax-module-infra</artifactId>
      <version>1.0.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.huanniankj</groupId>
      <artifactId>ubax-spring-boot-starter-web</artifactId>
      <version>1.0.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.huanniankj</groupId>
      <artifactId>ubax-spring-boot-starter-mybatis</artifactId>
      <version>1.0.0</version>
      <scope>compile</scope>
    </dependency>
