<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.huanniankj</groupId>
        <artifactId>uba-x</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <packaging>jar</packaging>
    <artifactId>ubax-module-source</artifactId>

    <name>${project.artifactId}</name>
    <description>
        数据源模块，包括Agent管理、事件管理、运行监控等。
    </description>

    <dependencies>
        <dependency>
            <groupId>com.huanniankj</groupId>
            <artifactId>ubax-spring-boot-starter-biz-tenant</artifactId>
        </dependency>
        <!-- Web 相关 -->
        <dependency>
            <groupId>com.huanniankj</groupId>
            <artifactId>ubax-spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 安全权限 -->
        <dependency>
            <groupId>com.huanniankj</groupId>
            <artifactId>ubax-spring-boot-starter-security</artifactId>
        </dependency>

        <!-- DB 相关 -->
        <dependency>
            <groupId>com.huanniankj</groupId>
            <artifactId>ubax-spring-boot-starter-mybatis</artifactId>
        </dependency>
        <!-- Hutool 等工具类 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>5.8.25</version>
        </dependency>

        <!-- JSqlParser SQL 解析 -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
            <version>4.9</version>
        </dependency>

        <!-- 数据库驱动 - 动态数据源支持多数据库类型 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc8</artifactId>
        </dependency>

        <!-- 基础依赖 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>

</project>
