  <url>https://github.com/HappyNewYear1995/UBA-X/ubax-module-source</url>
  <dependencies>
    <dependency>
      <groupId>com.huanniankj</groupId>
      <artifactId>ubax-spring-boot-starter-biz-tenant</artifactId>
      <version>1.0.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.huanniankj</groupId>
      <artifactId>ubax-spring-boot-starter-web</artifactId>
      <version>1.0.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.huanniankj</groupId>
      <artifactId>ubax-spring-boot-starter-security</artifactId>
      <version>1.0.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.huanniankj</groupId>
      <artifactId>ubax-spring-boot-starter-mybatis</artifactId>
      <version>1.0.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>cn.hutool</groupId>
      <artifactId>hutool-all</artifactId>
      <version>5.8.25</version>
